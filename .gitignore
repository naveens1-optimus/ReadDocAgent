# ---------------------------------------------------------------------------
# Secrets -- MUST stay first. Never commit real credentials or connection
# strings; `.env.example` is the committed template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/

# Test / type-check / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# LangGraph checkpointer databases (SqliteSaver) -- runtime state, not source
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
checkpoints/

# ---------------------------------------------------------------------------
# Local runtime artifacts
# ---------------------------------------------------------------------------
logs/
*.log
tmp/
temp/
uploads/
outputs/

# ---------------------------------------------------------------------------
# Node / frontend (M13)
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
