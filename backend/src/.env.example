# ===========================================================================
# Multi-Agent IDP Pipeline -- environment template
#
#   cp .env.example .env      then fill in the real values.
#
# `.env` is git-ignored and MUST NEVER be committed. No credential may ever
# be hardcoded in source; everything below is read via load_env.py.
#
# Authentication is KEY-BASED throughout (no managed identity).
# Keys marked [REQUIRED] raise a startup error when missing.
# ===========================================================================

# ---------------------------------------------------------------------------
# Azure Document Intelligence  (Agent 2 -- data extraction)
# Portal: your resource -> Keys and Endpoint
# ---------------------------------------------------------------------------
# [REQUIRED] e.g. https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# [REQUIRED] KEY 1 or KEY 2 -- used as AzureKeyCredential
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Service API version. 2024-11-30 is the GA version for SDK 1.0.x.
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# ---------------------------------------------------------------------------
# Azure OpenAI  (Agent 1 vision classification, Agent 3 enrichment/summary)
# Portal: your resource -> Keys and Endpoint
# ---------------------------------------------------------------------------
# [REQUIRED] e.g. https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# [REQUIRED] KEY 1 or KEY 2
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# [REQUIRED] Deployment name for text tasks (enrichment, structuring, summary).
AZURE_OPENAI_CHAT_DEPLOYMENT=
# [REQUIRED] Deployment name for the vision-capable model used to classify
# documents (must be a vision model, e.g. a gpt-4o deployment). May be the
# same deployment as AZURE_OPENAI_CHAT_DEPLOYMENT if it supports images.
AZURE_OPENAI_VISION_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Azure Blob Storage  (Agent 4 -- output & storage)
# Portal: storage account -> Access keys -> Connection string
# ---------------------------------------------------------------------------
# [REQUIRED] Full connection string (contains the account key).
AZURE_STORAGE_CONNECTION_STRING=
# Containers are created automatically if they do not exist.
AZURE_STORAGE_INPUT_CONTAINER=idp-input
AZURE_STORAGE_OUTPUT_CONTAINER=idp-output

# ---------------------------------------------------------------------------
# Azure Cosmos DB  (LangGraph checkpointer -- durable human-in-the-loop state)
# Portal: your Cosmos account -> Keys
#
# The checkpointer is what lets a run pause for human approval on one request
# and resume on a later one. The database and container are created on first
# use, so only the account itself needs to exist.
# ---------------------------------------------------------------------------
# [REQUIRED] e.g. https://<account-name>.documents.azure.com:443/
AZURE_COSMOS_ENDPOINT=
# [REQUIRED] PRIMARY KEY or SECONDARY KEY
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=idp_langgraph
AZURE_COSMOS_CONTAINER=checkpoints
# Validated entities are stored here, keyed on document id.
AZURE_COSMOS_ENTITY_CONTAINER=entities

# ---------------------------------------------------------------------------
# LangSmith  (tracing + logging for every graph run)
# https://smith.langchain.com -> Settings -> API Keys
# ---------------------------------------------------------------------------
# Set to true to enable tracing. When false/unset the app runs normally and
# all tracing calls no-op.
LANGSMITH_TRACING=false
# [REQUIRED only when LANGSMITH_TRACING=true]
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doc-int-agent-system
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
# local | development | staging | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# text (human-readable) | json (structured, for log aggregators)
LOG_FORMAT=text

# Extracted fields with an Azure confidence score below this threshold are
# flagged by Agent 3 and trigger the human-in-the-loop checkpoint. 0.0-1.0.
CONFIDENCE_THRESHOLD=0.80

# Absolute tolerance when cross-validating money arithmetic (line items ->
# subtotal + tax -> total). Guards against float/rounding noise.
ARITHMETIC_TOLERANCE=0.01

# Reject uploads larger than this, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# ---------------------------------------------------------------------------
# Retry policy for Azure API calls (exponential backoff + jitter)
# ---------------------------------------------------------------------------
# Total attempts, including the first one.
AZURE_MAX_ATTEMPTS=4
# Base delay in seconds; delay grows as base * 2**(attempt-1), plus jitter.
AZURE_RETRY_BASE_DELAY_SECONDS=1.0
# Upper bound on any single backoff delay, in seconds.
AZURE_RETRY_MAX_DELAY_SECONDS=30.0

# ---------------------------------------------------------------------------
# API server (development entry point: `python main.py`)
# ---------------------------------------------------------------------------
# Bind address. Use 0.0.0.0 to accept connections from outside the machine.
API_HOST=127.0.0.1
API_PORT=8000
# Auto-reload on code changes. Turn off for anything but local development.
API_RELOAD=true
